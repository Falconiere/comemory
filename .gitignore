/target
/.claude/tmp/
/.claude/settings.local.json
/.codex/tmp/
/.fastembed_cache/
# cargo-mutants scratch output — never committed
/mutants.out/
/mutants.out.old/

# Local MCP config — not committed
.mcp.json

# Criterion bench report — hardware-variable, regenerated by `just bench`
# (the HTML report under target/criterion/ is already covered by /target).
/docs/bench/latest.md

# claudness workflow artifacts (specs/plans) — local, not committed
/docs/claudness/

# toolu workflow artifacts (specs/plans) — local, not committed
/docs/toolu/

# Serena MCP local project cache — not committed
/.serena/

# The comemory.io platform monorepo is a separate git repo that
# gets cloned inside this checkout — never a directory of this one.
/comemory.io/

# The one-line checksum file README's verification recipe writes. Never
# committed. (`/install.sh` used to be listed here too, back when it was the
# cargo-dist download; the repo-root install.sh is now source — see
# release-finalize.yml, which ships it.)
/line.sum

# Python bytecode from scripts/lib helpers
__pycache__/
*.pyc

# Offline LoRA training and qualification artifacts (#214). Model weights and
# user-derived training exports never enter a normal source commit: an adapter
# is hundreds of megabytes of derived state, and a dataset export carries
# snapshots of the operator's own passages. The three directories are the
# convention `integrations/training/README.md` documents; the file names below
# are the owned name set `comemory export-dataset` writes wherever it is
# pointed, so an export into an ad-hoc directory is still never staged.
/lora-adapters/
/lora-datasets/
/lora-qualification/
*.safetensors
train.jsonl
validation.jsonl
holdout.jsonl
train.implicit.jsonl
validation.implicit.jsonl
holdout.implicit.jsonl
