{
  "schemaVersion": 1,
  "name": "comemory",
  "displayName": "comemory",
  "version": "0.0.0-dev",
  "description": "Repo-scoped developer memory and project skills, owned by comemory.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "agent-memory",
        "path": "skills/agent-memory/SKILL.md"
      },
      {
        "id": "architecture-map",
        "path": "skills/architecture-map/SKILL.md"
      },
      {
        "id": "memory-bootstrap",
        "path": "skills/memory-bootstrap/SKILL.md"
      },
      {
        "id": "project-skills",
        "path": "skills/project-skills/SKILL.md"
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/session-start.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "comemory-status",
        "event": "SessionStart",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/comemory-status.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "project-skills-index",
        "event": "SessionStart",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/project-skills-index.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "user-prompt-submit",
        "event": "UserPromptSubmit",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/memory-lifecycle.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "skill-use",
        "event": "PostToolUse",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/skill-use.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "stop",
        "event": "Stop",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/stop.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "pre-compact",
        "event": "PreCompact",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/pre-compact.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "project-skills-curate",
        "event": "Stop",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/project-skills-curate.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "session-end",
        "event": "SessionEnd",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/session-end.sh"],
        "timeoutMs": 15000
      },
      {
        "id": "scope",
        "event": "PreToolUse",
        "command": ["/usr/bin/env", "TOOLU_HOST_OVERRIDE=muse", "bash", "hooks/scope.sh"],
        "timeoutMs": 15000
      }
    ],
    "mcpServers": [
      {
        "id": "comemory",
        "transport": "stdio",
        "command": ["/usr/bin/env", "comemory", "mcp"]
      }
    ],
    "reminders": []
  }
}
