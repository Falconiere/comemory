  "shared_domain_dependencies": [
    {
      "source": "src/config/sync.rs",
      "target": "crate::domains::sync::skip_repos::SkipMatcher",
      "owner": "domains::sync",
      "reason": "config::validate must reject an invalid [sync] skip_repos glob at load, and the matcher owns the lowercase normalization that decides what a pattern means; duplicating the compile inside config would fork that rule."
    },
    {
      "source": "src/utilities/id_list.rs",
      "target": "crate::domains::memories::id::is_valid_memory_id",
      "owner": "domains::memories",
      "reason": "the shared --ids/--used list parser rejects a malformed id up front, and the memory-id format is the memories capability's contract, not a string shape utilities may restate."
    },
    {
      "source": "src/utilities/ref_args.rs",
      "target": "crate::domains::code::git_utils",
      "owner": "domains::code",
      "reason": "--ref-* anchoring resolves a blob OID and the current branch/HEAD through the one Git reader in the code capability, rather than opening a second repository handle."
    },
    {
      "source": "src/utilities/ref_args.rs",
      "target": "crate::domains::memories::Ref",
      "owner": "domains::memories",
      "reason": "the shared --ref-* parser's output IS a memories value; producing a structurally identical local type would be the duplication the ledger exists to prevent."
    },
    {
      "source": "src/utilities/ref_args.rs",
      "target": "crate::domains::memories::References",
      "owner": "domains::memories",
      "reason": "as above: the parsed collection is the memories model both delivery adapters hand to save/update."
    }
  ]
