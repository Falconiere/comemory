{
  "$schema": "./scripts/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "nested": {
      "store": [
        "sql",
        "tokenizer",
        "migrate",
        "tests"
      ],
      "api": [
        "doctor",
        "index_code",
        "memory_store",
        "rebuild",
        "repos",
        "tests",
        "proptest-regressions"
      ],
      "cli": [
        "graph",
        "tests",
        "proptest-regressions"
      ],
      "retrieval": [
        "unified",
        "tests",
        "proptest-regressions"
      ],
      "serve": [
        "routes",
        "jobs",
        "tests",
        "proptest-regressions"
      ],
      "serve/routes": [
        "memories",
        "maint",
        "tests",
        "proptest-regressions"
      ],
      "*": [
        "tests",
        "proptest-regressions"
      ]
    },
    "requireReadme": [
      "api",
      "api/doctor",
      "api/index_code",
      "api/memory_store",
      "api/rebuild",
      "api/repos",
      "ast",
      "cli",
      "cli/graph",
      "config",
      "consolidate",
      "document",
      "eval",
      "graph",
      "memory",
      "output",
      "prune",
      "retrieval",
      "retrieval/unified",
      "serve",
      "serve/jobs",
      "serve/routes",
      "serve/routes/maint",
      "serve/routes/memories",
      "source",
      "stats",
      "store",
      "store/migrate",
      "store/sql",
      "store/tokenizer"
    ]
  },
  "fileSize": {
    "max": 300,
    "overrides": {
      ".github/workflows/release.yml": 400
    },
    "skipExtensions": [
      ".md",
      ".lock"
    ]
  },
  "functionSize": {
    "max": 100
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [
    "mod.rs"
  ],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env",
      ".mcp.json"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "the lefthook 2.x installer shadows a .yaml, so the hooks never run"
    }
  ],
  "ownedByLinter": []
}
