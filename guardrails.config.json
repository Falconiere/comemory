{
  "$schema": "./scripts/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "topLevel": [
      "api",
      "ast",
      "capture",
      "cli",
      "cloud",
      "config",
      "consolidate",
      "document",
      "domains",
      "eval",
      "graph",
      "memory",
      "output",
      "prune",
      "retrieval",
      "serve",
      "source",
      "stats",
      "store",
      "sync",
      "tests",
      "upgrade",
      "utilities"
    ],
    "nested": {
      "domains": [
        "memories",
        "code",
        "documents",
        "graph",
        "retrieval",
        "learning",
        "sync",
        "capture",
        "maintenance",
        "integrations"
      ],
      "domains/*": [
        "ast",
        "cloud",
        "consolidation",
        "doctor",
        "document",
        "evaluation",
        "exchange",
        "index_code",
        "memory_store",
        "rebuild",
        "repos",
        "retention",
        "source",
        "unified",
        "upgrade",
        "tests",
        "proptest-regressions"
      ],
      "store": [
        "tokenizer",
        "migrate",
        "tests"
      ],
      "api": [
        "doctor",
        "index_code",
        "memory_store",
        "rebuild",
        "repos",
        "sync",
        "tests",
        "proptest-regressions",
        "install",
        "setup"
      ],
      "cli": [
        "graph",
        "tests",
        "proptest-regressions",
        "setup"
      ],
      "retrieval": [
        "unified",
        "tests",
        "proptest-regressions"
      ],
      "sync": [
        "auth_file",
        "redact",
        "skip_repos",
        "tests",
        "proptest-regressions"
      ],
      "capture": [
        "tests",
        "proptest-regressions"
      ],
      "serve": [
        "routes",
        "jobs",
        "tests",
        "proptest-regressions"
      ],
      "serve/routes": [
        "memories",
        "maint",
        "tests",
        "proptest-regressions"
      ],
      "*": [
        "tests",
        "proptest-regressions"
      ]
    },
    "requireReadme": [
      "api",
      "domains/maintenance/doctor",
      "domains/sync/memory_store",
      "domains/maintenance/rebuild",
      "domains/sync/exchange",
      "cli",
      "config",
      "domains/maintenance/consolidation",
      "domains/learning",
      "output",
      "domains/maintenance/retention",
      "domains/retrieval",
      "domains/retrieval/unified",
      "serve",
      "serve/jobs",
      "serve/routes",
      "serve/routes/maint",
      "serve/routes/memories",
      "domains/sync",
      "domains/learning/evaluation",
      "store",
      "store/migrate",
      "store/tokenizer",
      "domains/maintenance/upgrade",
      "domains/capture",
      "domains/sync/cloud",
      "api/install",
      "api/setup",
      "cli/setup",
      "utilities",
      "domains",
      "domains/code",
      "domains/memories",
      "domains/code/ast",
      "domains/code/index_code",
      "domains/code/repos",
      "domains/documents",
      "domains/documents/document",
      "domains/documents/source",
      "domains/graph",
      "domains/maintenance"
    ]
  },
  "fileSize": {
    "max": 300,
    "overrides": {
      ".github/workflows/release.yml": 400
    },
    "skipExtensions": [
      ".md",
      ".lock"
    ]
  },
  "functionSize": {
    "max": 100
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [
    "mod.rs"
  ],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env",
      ".mcp.json"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "the lefthook 2.x installer shadows a .yaml, so the hooks never run"
    }
  ],
  "ownedByLinter": []
}
