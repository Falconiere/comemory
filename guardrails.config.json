{
  "$schema": "./scripts/guardrails/schema.json",
  "version": 2,
  "srcRoot": "src",
  "src": {
    "nested": {
      "store": [
        "sql",
        "tokenizer",
        "tests"
      ],
      "tui": [
        "view",
        "tests"
      ],
      "*": [
        "tests",
        "proptest-regressions"
      ]
    }
  },
  "fileSize": {
    "max": 300,
    "skipExtensions": []
  },
  "functionSize": {
    "max": 100
  },
  "testDir": "tests",
  "testGlob": "",
  "barrelNames": [
    "mod.rs"
  ],
  "barrelExempt": [],
  "bannedDeps": [],
  "filenameCase": [
    {
      "glob": "*.rs",
      "regex": "^[a-z0-9_]+[.]rs$",
      "describe": "snake_case"
    }
  ],
  "secrets": {
    "neverTracked": [
      ".env",
      ".mcp.json"
    ]
  },
  "shadowConfigs": [
    {
      "found": "lefthook.yaml",
      "use": "lefthook.yml",
      "why": "the lefthook 2.x installer shadows a .yaml, so the hooks never run"
    }
  ],
  "ownedByLinter": []
}
